{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codemate-ai",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "vars": {
    "AI_BASE_URL": "https://api.deepseek.com",
    "AI_MODEL": "deepseek-flash",
    "AI_MAX_TOKENS": "700"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
